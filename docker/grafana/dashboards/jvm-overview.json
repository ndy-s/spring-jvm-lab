    {
      "type": "timeseries",
      "title": "GC pauses per second",
      "description": "How often each collector stops the application, and why (cause).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
