    {
      "type": "timeseries",
      "title": "Non-heap memory by pool",
      "description": "Metaspace (class metadata), CodeHeap (JIT-compiled code), Compressed Class Space. Not limited by -Xmx, but still counts toward the container's mem_limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
