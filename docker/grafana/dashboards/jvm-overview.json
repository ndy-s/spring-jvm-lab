    {
      "type": "timeseries",
      "title": "Allocation & promotion rate",
      "description": "Allocation rate drives how often young GCs run. Promotion rate is how fast objects survive long enough to move into the old generation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(jvm_gc_memory_allocated_bytes_total[1m])",
          "legendFormat": "allocated (young gen)",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(jvm_gc_memory_promoted_bytes_total[1m])",
          "legendFormat": "promoted to old gen",
          "refId": "B",
          "range": true
