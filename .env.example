# Copy to .env and edit. Only the GC flag usually changes between experiments.
#
# Swap -XX:+UseG1GC for one of:
#   -XX:+UseZGC            (low-latency, concurrent, generational since JDK 21)
#   -XX:+UseShenandoahGC   (low-latency, concurrent)
#   -XX:+UseParallelGC     (throughput, stop-the-world)
#   -XX:+UseSerialGC       (single-threaded, stop-the-world)
# then: docker compose up -d app
JAVA_OPTS=-XX:+UseG1GC -Xms256m -Xmx256m -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/dumps -Xlog:gc*:file=/gc-logs/gc.log:time,uptime,level,tags -XX:StartFlightRecording=disk=true,dumponexit=true,filename=/jfr/continuous.jfr
